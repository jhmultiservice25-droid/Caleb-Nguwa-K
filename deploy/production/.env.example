# État Civil RDC - production variables
# NEVER commit real secrets. Copy to .env.production on the deployment host or CI secret store.

# Public hostname (DNS A/AAAA must point to the server/cluster)
HOST=etatcivil.example.cd

# OpenCRVS versions
OPENCRVS_CORE_VERSION=latest
COUNTRY_CONFIG_VERSION=rdc-2026-09
REPLICAS=1

# Country-config image registry (Docker Hub compatible naming expected by OpenCRVS compose)
DOCKERHUB_ACCOUNT=your-registry-account
DOCKERHUB_REPO=opencrvs-rdc-countryconfig

# Remote deployment target
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=opencrvs

# Operational contact / Let's Encrypt ACME email
ALERT_EMAIL=admin@example.cd

# Secret values: generate with `openssl rand -base64 48`
MINIO_ROOT_USER=CHANGE_ME_RANDOM_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_64_CHAR_RANDOM_SECRET

# Security policy
SESSION_COOKIE_SECURE=true
NODE_ENV=production

# Other OpenCRVS-required passwords/secrets are generated/rotated by the official
# deployment scripts or supplied through the CI/secret store. Never commit them.
