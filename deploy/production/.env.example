# État Civil RDC - production variables
# NEVER commit real secrets. Copy to .env.production on the deployment host.

# Public hostname (DNS A/AAAA must point to the server/cluster)
HOST=etatcivil.example.cd

# OpenCRVS versions
OPENCRVS_CORE_VERSION=latest
COUNTRY_CONFIG_VERSION=local-rdc
REPLICAS=1

# Remote deployment target
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=opencrvs

# Operational contact
ALERT_EMAIL=admin@example.cd

# Secret values: generate with `openssl rand -base64 48`
MINIO_ROOT_USER=CHANGE_ME_RANDOM_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_64_CHAR_RANDOM_SECRET

# Security policy
SESSION_COOKIE_SECURE=true
NODE_ENV=production

# Optional SMTP/SMS integrations should be supplied as secrets at runtime,
# not committed in this file.
